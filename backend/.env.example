PORT=4370
# 4370 dipakai sebagai contoh karena ini port default komunikasi ZKTeco,
# tapi endpoint ADMS boleh di port lain (mis. 8080) selama X105 dikonfigurasi
# mengarah ke IP:PORT server ini di menu Comm > Cloud Server Setting.

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WAJIB pakai service_role key (bukan anon key) karena backend ini jalan
# sebagai trusted server di LAN sekolah dan perlu bypass RLS untuk insert
# log absensi mentah dari mesin.

JWT_SECRET_FOR_APP=ganti_dengan_secret_acak
